{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.codex/hooks/codex-dir-check.sh",
            "statusMessage": "Checking Codex config access"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.codex/hooks/compound-check.sh",
            "statusMessage": "Checking shell command policy"
          },
          {
            "type": "command",
            "command": "bash $HOME/.codex/hooks/critical-rm-check.sh",
            "statusMessage": "Checking shell command policy"
          },
          {
            "type": "command",
            "command": "bash $HOME/.codex/hooks/aws-readonly-check.sh",
            "statusMessage": "Checking shell command policy"
          },
          {
            "type": "command",
            "command": "$HOME/.codex/hooks/npm-to-pnpm.sh",
            "statusMessage": "Checking shell command policy"
          },
          {
            "type": "command",
            "command": "$HOME/.codex/hooks/pre-commit-check.sh",
            "timeout": 60,
            "statusMessage": "Checking shell command policy"
          },
          {
            "type": "command",
            "command": "$HOME/.codex/hooks/pre-push-check.sh",
            "timeout": 900,
            "statusMessage": "Checking shell command policy"
          },
          {
            "type": "command",
            "command": "$HOME/.codex/hooks/semgrep-check.sh",
            "timeout": 120,
            "statusMessage": "Checking shell command policy"
          }
        ]
      },
      {
        "matcher": "mcp__.*[Aa][Ww][Ss].*",
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.codex/hooks/aws-mcp-readonly-check.sh",
            "statusMessage": "Checking AWS MCP tool is read-only"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.codex/hooks/prettier-format.sh",
            "timeout": 15,
            "statusMessage": "Formatting changed files"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.codex/hooks/sessionstart-symlink-check.sh",
            "statusMessage": "Checking Codex symlink integrity"
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash $HOME/.codex/hooks/sessionstart-compact-restore.sh",
            "timeout": 15,
            "statusMessage": "Restoring pre-compaction requests"
          }
        ]
      }
    ]
  }
}
